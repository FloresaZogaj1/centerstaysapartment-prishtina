# Backend environment variables example

# Mongo / server
PORT=5000
MONGODB_URI=your-mongodb-uri
FRONTEND_URL=http://localhost:5173

# BKT (existing) - do not remove
# BKT_* variables ...

# Bankart / NLB configuration (preferred settings)
# Preferred: set POST_URL to the gateway base (no path). The service will append
# 
#   /api/v3/transaction/{encodedApiKey}/debit
#
# Example (preferred):
# NLB_BANKART_POST_URL=https://gateway.bankart.si

# Alternative (less recommended):
# NLB_BANKART_POST_URL=https://gateway.bankart.si/api/v3/transaction
# The service will normalize either value so duplication is avoided, but prefer
# the base-only form to keep envs simpler.

NLB_BANKART_MODE=test
NLB_BANKART_API_KEY=210844IP021844-SIM
NLB_BANKART_SHARED_SECRET=your-shared-secret
NLB_BANKART_PUBLIC_INTEGRATION_KEY=
NLB_BANKART_POST_URL=https://gateway.bankart.si
NLB_BANKART_CALLBACK_URL=https://your.public/callback
NLB_BANKART_SUCCESS_URL=https://your.public/payment/success
NLB_BANKART_FAIL_URL=https://your.public/payment/fail
NLB_BANKART_CONFIRMED_IMPLEMENTATION=false

# Optional backend API credentials (only if required by your Bankart account)
NLB_BANKART_API_USERNAME=
NLB_BANKART_API_PASSWORD=

# Notes:
# - The service will append /api/v3/transaction/{encodedApiKey}/debit to the
#   value of NLB_BANKART_POST_URL. Set POST_URL to the gateway base URL
#   (https://gateway.bankart.si) for the canonical final endpoint
#   https://gateway.bankart.si/api/v3/transaction/{encodedApiKey}/debit
# - Do NOT commit real secrets into source control. Store these in your
#   deployment environment (Render, Vercel, etc.) or a secrets manager.
# backend/.env.example
# PLACEHOLDERS ONLY — do NOT commit real credentials here.
# Copy this file to backend/.env and fill in real values locally.

MONGODB_URI=
PORT=5000
FRONTEND_URL=http://localhost:5173
ADMIN_API_KEY=change_me
ADMIN_EMAIL=centerstays@gmail.com

# BKT / NestPay (3D_PAY_HOSTING) placeholders
BKT_CLIENT_ID=
BKT_STORE_KEY=
BKT_STORE_TYPE=3D_PAY_HOSTING
BKT_CURRENCY=978
BKT_TRAN_TYPE=Auth
BKT_3D_POST_URL=https://pgw.bkt-ks.com/fim/est3Dgate
BKT_API_USERNAME=
BKT_API_PASSWORD=
BKT_API_POST_URL=https://pgw.bkt-ks.com/fim/api
BKT_OK_URL=https://centerstaysapartment-prishtina.onrender.com/api/payments/bkt/ok
BKT_FAIL_URL=https://centerstaysapartment-prishtina.onrender.com/api/payments/bkt/fail
BKT_CANCEL_URL=https://centerstaysapartment-prishtina.onrender.com/api/payments/bkt/fail
BKT_CALLBACK_URL=https://centerstaysapartment-prishtina.onrender.com/api/payments/bkt/callback
BKT_SUCCESS_URL=
BKT_LANG=en
BKT_REFRESH_TIME=5

# SMTP / Email (placeholders)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

NLB_BANKART_MODE=live
# Example API Key: contains a pipe '|' which must be URL-encoded when used in the path
# Note: API keys may previously have contained a pipe '|' which required URL-encoding.
# The current test key uses an uppercase 'I' between the segments and does NOT require
# special pipe-encoding handling.
NLB_BANKART_API_KEY=210844IP021844
NLB_BANKART_SHARED_SECRET=your-shared-secret-here
NLB_BANKART_PUBLIC_INTEGRATION_KEY=
NLB_BANKART_API_USERNAME=your_api_username
NLB_BANKART_API_PASSWORD=your_api_password
# Bankart v3 base API URL
NLB_BANKART_POST_URL=https://gateway.bankart.si
NLB_BANKART_CALLBACK_URL=https://centerstays.apartments/api/payments/bankart/callback
NLB_BANKART_SUCCESS_URL=https://centerstays.apartments/#/payment/success
NLB_BANKART_CANCEL_URL=https://centerstays.apartments/#/payment/cancel
NLB_BANKART_FAIL_URL=https://centerstays.apartments/#/payment/fail
# Safety flag — must be set to 'true' to enable live flow in the server
NLB_BANKART_CONFIRMED_IMPLEMENTATION=false
NLB_BANKART_DASHBOARD_URL=https://gateway.bankart.si/en/dashboard

# TODO: Bankart / NLB - integration notes
# - The NLB_BANKART_POST_URL above is a tentative placeholder. Confirm the
#   exact API endpoint in the Bankart portal documentation and update this value.
# - Confirm whether the integration requires frontend tokenization (payment.js)
#   or a server-side /session or /transaction POST. Update implementation
#   accordingly in backend/src/services/bankartService.js.
# - Set NLB_BANKART_CONFIRMED_IMPLEMENTATION=true only after you have
#   verified the signature canonicalization and callback verification steps.